# ---------------------------------------------------------------------------
# Runtime
# `preview` is for development and tests only; production requires google-sheets.
# ---------------------------------------------------------------------------
DATA_PROVIDER=preview
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_LANDING_PAGE_VERSION=phase1

# ---------------------------------------------------------------------------
# Google Sheets (server-only — never expose through NEXT_PUBLIC_*)
# ---------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the full key. Literal \n sequences are converted to real newlines.
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=
GOOGLE_PRODUCT_SHEET=Product_Master
GOOGLE_CUSTOMER_SHEET=Customers
GOOGLE_INQUIRY_SHEET=Inquiries
GOOGLE_EVENT_SHEET=Events
GOOGLE_CALLBACK_SHEET=Callback_Requests

# Comma-separated HTTPS hosts allowed to serve product imagery. Build-time only.
PRODUCT_IMAGE_HOSTS=

# ---------------------------------------------------------------------------
# Calendly — global fallbacks. A Product_Master row always wins over these.
# ---------------------------------------------------------------------------
# The scheduling page supplied so far resolves to a Calendly event type named
# "MK Jewels - Video Meet" (30 min, web conferencing). It is therefore only
# valid for CALENDLY_VIDEO_URL. Pointing CALENDLY_STORE_VISIT_URL at it would
# book a video call for a customer who asked to come into the store, so a
# separate in-person event type is required before launch:
#   https://calendly.com/mis-mkjewels/new-meeting
# Left blank by default so local runs and e2e tests exercise the fallback state.
CALENDLY_STORE_VISIT_URL=
CALENDLY_VIDEO_URL=
# Leave false until a real Calendly booking event has been verified end to end.
CALENDLY_CAPTURE_BOOKINGS=false

# ---------------------------------------------------------------------------
# WhatsApp — country code and number, digits only (for example 919876543210).
# ---------------------------------------------------------------------------
WHATSAPP_NUMBER=
# Placeholders: {productId} {productName} {inquiryId}. Never include lead PII.
WHATSAPP_MESSAGE_TEMPLATE=

# ---------------------------------------------------------------------------
# Recovery
# When set, every unresolved-context state offers a "Speak to a jewellery
# expert" link instead of leaving the customer at a dead end.
# ---------------------------------------------------------------------------
ASSISTED_SUPPORT_URL=
