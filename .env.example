# Runtime. Preview is development/test only; production requires Google Sheets.
NODE_ENV=development
DATA_PROVIDER=preview
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_LANDING_PAGE_VERSION=attribution-v1

# Temporary confirmation copy. Final copy will be approved in the redesign phase.
NEXT_PUBLIC_OFFER_UNLOCKED_COPY=Your promotional offer has been unlocked.
NEXT_PUBLIC_REPRESENTATIVE_CONTACT_COPY=An MK Jewels representative will contact you shortly regarding your enquiry.

# Reserved for the next redesign phase. Must be HTTPS when set; not rendered yet.
NEXT_PUBLIC_BRAND_VIDEO_URL=

# Google Sheets (server-only; never prefix these with NEXT_PUBLIC_).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=
GOOGLE_PRODUCT_SHEET=Product_Master
GOOGLE_CUSTOMER_SHEET=Customers
GOOGLE_INQUIRY_SHEET=Inquiries
GOOGLE_EVENT_SHEET=Events

# Distributed production rate limiting. Local development falls back to memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional HTTPS recovery link for missing, invalid, or inactive contexts.
ASSISTED_SUPPORT_URL=
