# Runtime. Preview is development/test only; production requires Google Sheets.
NODE_ENV=development
DATA_PROVIDER=preview
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_LANDING_PAGE_VERSION=final-light-v1

# Optional approved overrides for the confirmation state.
NEXT_PUBLIC_OFFER_UNLOCKED_COPY=Your exclusive benefit is unlocked.
NEXT_PUBLIC_REPRESENTATIVE_CONTACT_COPY=An MK Jewels representative will contact you shortly regarding the jewellery you selected.

# Brand film override: /public path or HTTPS MP4/YouTube/Vimeo URL. Optional —
# empty uses brandVideoConfig.src (/brand/mk-jewels-intro.mp4).
NEXT_PUBLIC_BRAND_VIDEO_URL=
# Second film below the form / success state. Same formats; empty uses
# secondVideoConfig.src (currently none, so the section is hidden).
NEXT_PUBLIC_SECOND_VIDEO_URL=

# Real enquiry count pill (per product + Reel + campaign).
SHOW_INQUIRY_COUNT=true
INQUIRY_COUNT_MODE=total
INQUIRY_COUNT_RECENT_HOURS=24
# Only honoured when INQUIRY_COUNT_MODE=recent.
INQUIRY_COUNT_SHOW_LIVE=false
INQUIRY_COUNT_MINIMUM=1

# Design review only: labelled placeholder metrics/reviews/testimonials for empty
# sections. Defaults to true in `next dev`; always off when NODE_ENV=production.
SHOW_DEVELOPMENT_SOCIAL_PROOF=true

# Google Sheets (server-only; never prefix these with NEXT_PUBLIC_).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=
GOOGLE_PRODUCT_SHEET=Products
# Reel/campaign → product mapping. Leave empty to use the product tab alone.
GOOGLE_REEL_MAP_SHEET=Reel_Product_Map
GOOGLE_CUSTOMER_SHEET=Customers
GOOGLE_INQUIRY_SHEET=Inquiries
GOOGLE_EVENT_SHEET=Events
# Operations copy of each new lead (best-effort). Leave empty to disable.
GOOGLE_INSTAGRAM_FMS_SHEET=Instagram_FMS
# Calendly bookings written by /api/webhooks/calendly.
GOOGLE_BOOKINGS_SHEET=Bookings
# Store pass: staff visits/purchases, and store names + PINs.
GOOGLE_STORE_VISITS_SHEET=Store_Visits
GOOGLE_STORES_SHEET=Stores

# Store pass (QR + code after every enquiry). PASS_SECRET signs the QR links and
# staff logins: at least 32 random characters, e.g. the output of
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Unset in production = no passes (the page works as before). Never change it
# once passes are issued, or their QR links stop working.
PASS_SECRET=
PASS_VALIDITY_DAYS=60

# Post-enquiry "Chat with us on WhatsApp" (server-only). Country code + number,
# e.g. 919876543210. Empty hides the button.
CRM_WHATSAPP_NUMBER=

# Calendly webhook (server-only). Signing key of the webhook subscription;
# empty disables the endpoint. Event type URIs decide booking_type
# (comma-separated https://api.calendly.com/event_types/... URIs).
CALENDLY_WEBHOOK_SIGNING_KEY=
CALENDLY_VIDEO_EVENT_TYPES=
CALENDLY_STORE_EVENT_TYPES=
# Default booking links for the post-enquiry "Book a video call demo" / "Book a
# store visit" buttons (https://calendly.com/... only). A product row's own
# calendly_video_url / calendly_store_url overrides these. Empty hides a button.
# On Calendly's free plan (one event type) both may be the same link; the
# embed tags each booking with the button chosen. CALENDLY_STORE_VISIT_URL is
# accepted as another name for CALENDLY_STORE_URL.
CALENDLY_VIDEO_URL=
CALENDLY_STORE_URL=

# Distributed production rate limiting, and the MK-YYMM-0000 reference counter.
# Local development falls back to memory (and random references).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional HTTPS recovery link for missing, invalid, or inactive contexts.
ASSISTED_SUPPORT_URL=
