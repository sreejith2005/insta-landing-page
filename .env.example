# Runtime. Preview is development/test only; production requires Google Sheets.
NODE_ENV=development
DATA_PROVIDER=preview
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_LANDING_PAGE_VERSION=final-light-v1

# Optional approved overrides for the confirmation state.
NEXT_PUBLIC_OFFER_UNLOCKED_COPY=Your exclusive benefit is unlocked.
NEXT_PUBLIC_REPRESENTATIVE_CONTACT_COPY=An MK Jewels representative will contact you shortly regarding the jewellery you selected.

# Brand film: /public path or HTTPS MP4/YouTube/Vimeo URL. Required in
# production; `next dev` uses /brand/mk-jewels-intro.mp4 automatically if present.
NEXT_PUBLIC_BRAND_VIDEO_URL=/brand/mk-jewels-intro.mp4

# Real enquiry count pill (per product + Reel + campaign).
SHOW_INQUIRY_COUNT=true
INQUIRY_COUNT_MODE=total
INQUIRY_COUNT_RECENT_HOURS=24
# Only honoured when INQUIRY_COUNT_MODE=recent.
INQUIRY_COUNT_SHOW_LIVE=false
INQUIRY_COUNT_MINIMUM=1

# Design review only: labelled placeholder metrics/reviews/testimonials for empty
# sections. Defaults to true in `next dev`; always off when NODE_ENV=production.
SHOW_DEVELOPMENT_SOCIAL_PROOF=true

# Google Sheets (server-only; never prefix these with NEXT_PUBLIC_).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=
GOOGLE_PRODUCT_SHEET=Products
# Reel/campaign → product mapping. Leave empty to use the product tab alone.
GOOGLE_REEL_MAP_SHEET=Reel_Product_Map
GOOGLE_CUSTOMER_SHEET=Customers
GOOGLE_INQUIRY_SHEET=Inquiries
GOOGLE_EVENT_SHEET=Events

# Distributed production rate limiting. Local development falls back to memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional HTTPS recovery link for missing, invalid, or inactive contexts.
ASSISTED_SUPPORT_URL=
